{
  "name": "@yt-media/desktop",
  "version": "0.1.0",
  "description": "Native desktop application for YT Media",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "icons:generate": "node scripts/generate-icons.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:visual": "playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.app.json --watch",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vitest-axe": "^0.1.0"
  }
}
